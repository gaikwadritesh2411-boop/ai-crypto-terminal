# Copy to .env (never commit it). Everything here is optional.
# NO exchange keys are needed or read: the app uses PUBLIC market data only.

# Exchange for public candles. Binance/Bybit block some cloud regions (HTTP 451); kraken/coinbase usually work.
EXCHANGE_ID=kraken
DB_PATH=data/paper_trading.db

# Optional AI commentary (text only, can never change risk or place trades)
# ANTHROPIC_API_KEY=

# Paper-account / risk overrides (defaults shown)
# INITIAL_BALANCE=10000
# RISK_PER_TRADE=0.01
# REWARD_RISK=2
# DAILY_LOSS_LIMIT=0.03
# MAX_OPEN_POSITIONS=3
# MAX_LEVERAGE=3
# ALLOW_SHORT=true
# FEE_RATE=0.001
# SLIPPAGE_RATE=0.0005
